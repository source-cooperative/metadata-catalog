  ],
  "id": "root-geospatial/flight-tracks",
  "title": "Flight Tracks",
  "description": "Historic aircraft flight tracks over the contiguous United States (CONUS), derived from ADS-B (Automatic Dependent Surveillance\u2013Broadcast) position reports captured by ground receiver networks. Each record is a GIS linestring geometry representing a single flight track segment, attributed with ICAO hex ID, aircraft type, start/end timestamps, and height above ground level (AGL) computed using a USGS 3DEP digital elevation model. Data is stored as hive-partitioned GeoParquet files indexed by quadkey, year, month, and day.",
  "license": "ODbL-1.0",
  "keywords": [
    "aviation",
    "flight-tracking",
    "ads-b",
    "aircraft-tracking",
    "trajectories",
    "geoparquet",
    "remote-sensing"
  ],
  "providers": [
    {
      "name": "Root Geospatial LLC",
      "roles": [
        "producer"
      ]
    },
    {
      "name": "ADS-B.lol",
      "roles": [
        "processor"
      ]
    },
    {
      "name": "USGS",
      "roles": [
        "processor"
      ]
    },
    {
