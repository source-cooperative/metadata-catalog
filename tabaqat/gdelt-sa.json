  "id": "tabaqat/gdelt-sa",
  "title": "GDELT-SA",
  "description": "Daily-updated Parquet dataset of GDELT 2.0 geopolitical event records filtered to Saudi Arabia, partitioned by calendar day. Each row represents a news-reported event with GDELT actor and action codes, Goldstein scale scores, and sentiment metrics across three geographic reference frames (Actor1, Actor2, Action location). Records are deduplicated by source URL and pipeline-enriched with nearest-city geographic matching and optionally scraped article full text.",
  "keywords": [
    "time-series",
    "event-data",
    "media-monitoring",
    "sentiment-analysis",
    "middle-east",
    "news-events",
    "conflict-monitoring"
  ],
  "providers": [
    {
      "name": "GDELT Project",
      "roles": [
        "producer",
        "licensor"
      ]
    },
