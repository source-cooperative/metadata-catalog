  "id": "hdx/hapi",
  "title": "HDX HAPI Cloud-Native",
  "description": "Parquet snapshots of the HDX Humanitarian API (HDX HAPI), operated by OCHA, aggregating standardized humanitarian data from multiple organizations across crisis-affected countries. Themes include affected people (refugees, IDPs, humanitarian needs), food security and prices, conflict events, poverty rates, baseline population, climate/rainfall, and operational presence of humanitarian organizations. Data is normalized to common administrative boundary codes to enable cross-source interoperability and automated humanitarian workflows.",
  "license": "CC-BY-4.0",
  "keywords": [
    "humanitarian",
    "hapi",
    "hdx",
    "hxl",
    "ocha",
    "parquet",
    "food-security",
    "demographics",
    "administrative-boundaries",
    "displacement",
    "conflict",
    "precipitation"
  ],
  "providers": [
    {
      "name": "UN OCHA HDX Humanitarian API",
      "description": "The HDX Humanitarian API (HAPI) provides standardized humanitarian indicators from multiple sources to facilitate automated workflows and visualizations supporting humanitarian decision-making.",
      "roles": [
        "producer",
        "processor"
      ],
      "url": "https://hapi.humdata.org/"
    },
    {
