  "id": "carbonplan/carbonplan-ocr",
  "title": "Open Climate Risk",
  "description": "Building-level wildfire risk assessment data for the continental United States from CarbonPlan's Open Climate Risk project. Combines USFS wildfire hazard data with Overture Maps building footprints and Census TIGER/Line boundaries, delivered as gridded Icechunk/Zarr risk tensors and vector risk data at building, block, tract, and county scales.",
  "license": "CC-BY-4.0",
  "keywords": [
    "wildfire",
    "conservation",
    "building-footprints",
    "climate",
    "census",
    "icechunk",
    "zarr",
    "geoparquet",
    "pmtiles"
  ],
