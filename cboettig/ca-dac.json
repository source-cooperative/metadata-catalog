  "id": "cboettig/ca-dac",
  "title": " California Disadvantaged Communities (DAC) and Economically Distressed Areas (EDA), 2023",
  "description": "California Department of Water Resources (DWR) layers identifying Disadvantaged Communities (DAC, median household income below 80% of statewide) and Economically Distressed Areas (EDA, MHI below 85% of statewide plus additional distress factors) at Census tract, place, block group, and county geographies. Designations are derived from ACS 2019\u20132023 5-year estimates joined to 2020 Census boundaries and indicate eligibility for California water-related funding programs. Layers are published as GeoParquet, PMTiles, and H3-partitioned Parquet files.",
  "keywords": [
    "demographics",
    "census",
    "administrative-boundaries",
    "geoparquet",
    "pmtiles",
    "h3"
  ],
