  "id": "cboettig/taxadb",
  "title": "Taxonomic names",
  "description": "A consolidated dataset of taxonomic naming authorities drawn from multiple biodiversity databases, including Catalogue of Life (COL), GBIF, IUCN, ITIS, NCBI, and Open Tree of Life (OTT). Each record links scientific names, vernacular (common) names, taxonomic rank, and taxonomic status across the full Linnaean hierarchy (kingdom through infraspecific epithet). The dataset contains over 27 million records distributed across 9 Parquet files in both Darwin Core and simplified common-name formats.",
  "keywords": [
    "taxonomy",
    "biodiversity",
    "species-names",
    "nomenclature",
    "taxonomic-classification",
    "vernacular-names"
  ],
