  "id": "geovibes/search",
  "title": "Search",
  "description": "A collection of geospatial image embeddings derived from satellite and aerial imagery over selected US areas of interest (Alabama, New Mexico), packaged as DuckDB databases bundled with nearest-neighbor similarity indices for efficient vector search. Each asset pairs per-tile geometries with high-dimensional embedding vectors produced by multiple foundation models including DINO ViT, EarthGenome SoftCon, Clay/NAIP, and Google Satellite Embeddings. Intended for similarity search and downstream machine learning tasks over Earth observation data.",
  "keywords": [
    "embeddings",
    "machine-learning",
    "satellite-imagery",
    "foundation-model",
    "earth-observation",
    "remote-sensing",
    "similarity-search"
  ],
