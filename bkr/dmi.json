  "id": "bkr/dmi",
  "title": "Nordic Regional NWP Models",
  "description": "A cloud-native Icechunk/Zarr archive of hourly numerical weather prediction output for the Nordic region and Arctic, combining the Danish HARMONIE model (2 km resolution, covering Greenland and Iceland) with the MetCoOp MEPS model (2.5 km resolution, covering the broader Nordic region). It provides atmospheric analysis and forecast fields as chunked, cloud-optimized array data.",
  "keywords": [
    "numerical-weather-prediction",
    "meteorology",
    "weather-forecasting",
    "weather",
    "atmospheric-modeling",
    "icechunk",
    "zarr",
    "arctic"
  ],
